// ============================================================
// START REROUTE
// ============================================================

void startJ3Reroute() {

  Serial.println();
  Serial.println(
    "================================"
  );
  Serial.println(
    "        ACCIDENT AT J2"
  );
  Serial.println(
    "================================"
  );

  Serial.println(
    "J2 ROUTE BLOCKED"
  );

  Serial.println(
    "CANCEL J2"
  );

  Serial.println(
    "NEW ROUTE: 10 KM VIA J3"
  );

  Serial.println(
    "DESTINATION: HOSPITAL 2"
  );

  // ==========================================================
  // MISSION REROUTING
  // ==========================================================

  missionState =
    MISSION_REROUTING;

  // ==========================================================
  // CANCEL J2
  // ==========================================================

  sendMessage(
    J2_MAC,
    "CANCEL_J2"
  );

  j2Prepared =
    false;

  j2DisplayState =
    DISPLAY_ACCIDENT;

  displayLCD2(
    "JUNCTION 2",
    "ACCIDENT BLOCKED"
  );

  // ==========================================================
  // PREPARE J3
  // ==========================================================

  sendMessage(
    J3_MAC,
    "PREPARE_J3_15"
  );

  j3Prepared =
    true;

  j3Time =
    J3_PREP_TIME;

  j3PreparationTimer =
    millis();

  j3DisplayState =
    DISPLAY_PREPARING;

  displayLCD3(
    "JUNCTION 3",
    "PREP: 15 SEC"
  );

  // ==========================================================
  // J3 ACTIVE
  // ==========================================================

  missionState =
    MISSION_J3_ACTIVE;
}

// ============================================================
// ESP-NOW RECEIVE CALLBACK
//
// ESP32 CORE 2.0.17 FORMAT
// ============================================================

void OnDataRecv(
  const uint8_t *mac,
  const uint8_t *data,
  int len
) {

  char message[100];

  int copyLength =
    len;

  if (
    copyLength > 99
  ) {

    copyLength = 99;
  }

  memcpy(
    message,
    data,
    copyLength
  );

  message[copyLength] =
    '\0';

  Serial.print(
    "RECEIVED: "
  );

  Serial.println(
    message
  );

  // ==========================================================
  // EMERGENCY FROM J1
  // ==========================================================

  if (
    strcmp(
      message,
      "EMERGENCY_CALL_J1"
    ) == 0
  ) {

    startEmergency(
      "JUNCTION 1"
    );

    return;
  }

  // ==========================================================
  // EMERGENCY FROM J2
  // ==========================================================

  if (
    strcmp(
      message,
      "EMERGENCY_CALL_J2"
    ) == 0
  ) {

    startEmergency(
      "JUNCTION 2"
    );

    return;
  }

  // ==========================================================
  // EMERGENCY FROM J3
  // ==========================================================

  if (
    strcmp(
      message,
      "EMERGENCY_CALL_J3"
    ) == 0
  ) {

    startEmergency(
      "JUNCTION 3"
    );

    return;
  }

  // ==========================================================
  // J1 ENTRY
  // ==========================================================

  if (
    strcmp(
      message,
      "J1_ENTRY"
    ) == 0
  ) {

    if (
      missionState ==
      MISSION_J1_ACTIVE
    ) {

      j1DisplayState =
        DISPLAY_AMBULANCE_GREEN;

      displayLCD1(
        "JUNCTION 1",
        "AMBULANCE GREEN"
      );

      Serial.println(
        "J1 ENTRY CONFIRMED"
      );

      Serial.println(
        "J1 GREEN PRIORITY"
      );
    }

    return;
  }

  // ==========================================================
  // J1 PASSED
  // ==========================================================

  if (
    strcmp(
      message,
      "J1_PASSED"
    ) == 0
  ) {

    if (
      missionState ==
      MISSION_J1_ACTIVE
    ) {

      j1Passed =
        true;

      j1Prepared =
        false;

      j1DisplayState =
        DISPLAY_COMPLETE;

      displayLCD1(
        "JUNCTION 1",
        "NORMAL 60 SEC"
      );

      Serial.println(
        "J1 PASSED"
      );

      Serial.println(
        "AMBULANCE MOVING TO J2"
      );

      missionState =
        MISSION_J2_ACTIVE;
    }

    return;
  }

  // ==========================================================
  // J2 ENTRY
  // ==========================================================

  if (
    strcmp(
      message,
      "J2_ENTRY"
    ) == 0
  ) {

    if (
      missionState ==
      MISSION_J2_ACTIVE &&
      !accidentAtJ2
    ) {

      j2DisplayState =
        DISPLAY_AMBULANCE_GREEN;

      displayLCD2(
        "JUNCTION 2",
        "AMBULANCE GREEN"
      );

      Serial.println(
        "J2 ENTRY CONFIRMED"
      );

      Serial.println(
        "J2 GREEN PRIORITY"
      );
    }

    return;
  }

  // ==========================================================
  // J2 PASSED
  // ==========================================================

  if (
    strcmp(
      message,
      "J2_PASSED"
    ) == 0
  ) {

    if (
      missionState ==
      MISSION_J2_ACTIVE &&
      !accidentAtJ2
    ) {

      j2Passed =
        true;

      j2Prepared =
        false;

      j2DisplayState =
        DISPLAY_COMPLETE;

      displayLCD2(
        "JUNCTION 2",
        "NORMAL 60 SEC"
      );

      Serial.println();
      Serial.println(
        "================================"
      );
      Serial.println(
        "       MISSION COMPLETE"
      );
      Serial.println(
        "         HOSPITAL 1"
      );
      Serial.println(
        "================================"
      );

      missionState =
        MISSION_COMPLETED;

      delay(2000);

      resetAllToNormal();

      updateNormalLCDs();
    }

    return;
  }

  // ==========================================================
  // J2 ACCIDENT
  // ==========================================================

  if (
    strcmp(
      message,
      "ACCIDENT_J2"
    ) == 0
  ) {

    if (
      missionState ==
      MISSION_J2_ACTIVE &&
      !j2Passed
    ) {

      accidentAtJ2 =
        true;

      startJ3Reroute();
    }

    return;
  }

  // ==========================================================
  // J3 ENTRY
  // ==========================================================

  if (
    strcmp(
      message,
      "J3_ENTRY"
    ) == 0
  ) {

    if (
      missionState ==
      MISSION_J3_ACTIVE
    ) {

      j3DisplayState =
        DISPLAY_AMBULANCE_GREEN;

      displayLCD3(
        "JUNCTION 3",
        "AMBULANCE GREEN"
      );

      Serial.println(
        "J3 ENTRY CONFIRMED"
      );

      Serial.println(
        "J3 GREEN PRIORITY"
      );
    }

    return;
  }

  // ==========================================================
  // J3 PASSED
  // ==========================================================

  if (
    strcmp(
      message,
      "J3_PASSED"
    ) == 0
  ) {

    if (
      missionState ==
      MISSION_J3_ACTIVE
    ) {

      j3Passed =
        true;

      j3Prepared =
        false;

      j3DisplayState =
        DISPLAY_COMPLETE;

      displayLCD3(
        "JUNCTION 3",
        "NORMAL 60 SEC"
      );

      Serial.println();
      Serial.println(
        "================================"
      );
      Serial.println(
        "       MISSION COMPLETE"
      );
      Serial.println(
        "         HOSPITAL 2"
      );
      Serial.println(
        "================================"
      );

      missionState =
        MISSION_COMPLETED;

      delay(2000);

      resetAllToNormal();

      updateNormalLCDs();
    }

    return;
  }
}

// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(
    115200
  );

  delay(1000);

  Serial.println();
  Serial.println(
    "================================"
  );
  Serial.println(
    "        LIFELANE AI"
  );
  Serial.println(
    "    A1 / AMBULANCE 1"
  );
  Serial.println(
    "================================"
  );

  // ==========================================================
  // WIFI
  // ==========================================================

  WiFi.mode(
    WIFI_STA
  );

  WiFi.disconnect();

  delay(100);

  // ==========================================================
  // ESP-NOW CHANNEL 1
  // ==========================================================

  esp_wifi_set_channel(
    1,
    WIFI_SECOND_CHAN_NONE
  );

  Serial.print(
    "A1 MAC: "
  );

  Serial.println(
    WiFi.macAddress()
  );

  // ==========================================================
  // ESP-NOW INIT
  // ==========================================================

  if (
    esp_now_init() != ESP_OK
  ) {

    Serial.println(
      "ESP-NOW INIT FAILED"
    );

    while (true) {

      delay(1000);
    }
  }

  Serial.println(
    "ESP-NOW INITIALIZED"
  );

  // ==========================================================
  // CALLBACK
  // ==========================================================

  esp_now_register_recv_cb(
    OnDataRecv
  );

  // ==========================================================
  // PEERS
  // ==========================================================

  addPeer(
    J1_MAC
  );

  addPeer(
    J2_MAC
  );

  addPeer(
    J3_MAC
  );

  // ==========================================================
  // LCDS
  // ==========================================================

  initializeLCDs();

  // ==========================================================
  // RESET
  // ==========================================================

  resetAllToNormal();

  // ==========================================================
  // INITIAL LCD
  // ==========================================================

  updateNormalLCDs();

  Serial.println();
  Serial.println(
    "A1 READY"
  );

  Serial.println(
    "5 KM ROUTE READY"
  );

  Serial.println(
    "10 KM REROUTE VIA J3 READY"
  );

  Serial.println();
}

// ============================================================
// LOOP
// ============================================================

void loop() {

  // ==========================================================
  // NORMAL
  // ==========================================================

  if (
    missionState ==
    MISSION_IDLE
  ) {

    runNormalJ1();

    runNormalJ2();

    runNormalJ3();

    if (
      millis() -
      lcdRefreshTimer >=
      1000
    ) {

      lcdRefreshTimer =
        millis();

      updateNormalLCDs();
    }

    return;
  }

  // ==========================================================
  // J1 ACTIVE
  // ==========================================================

  if (
    missionState ==
    MISSION_J1_ACTIVE
  ) {

    updateJ1Preparation();

    updateJ2Preparation();

    return;
  }

  // ==========================================================
  // J2 ACTIVE
  // ==========================================================

  if (
    missionState ==
    MISSION_J2_ACTIVE
  ) {

    updateJ2Preparation();

    return;
  }

  // ==========================================================
  // J3 ACTIVE
  // ==========================================================

  if (
    missionState ==
    MISSION_J3_ACTIVE
  ) {

    updateJ3Preparation();

    return;
  }

  // ==========================================================
  // REROUTING
  // ==========================================================

  if (
    missionState ==
    MISSION_REROUTING
  ) {

    return;
  }

  // ==========================================================
  // COMPLETED
  // ==========================================================

  if (
    missionState ==
    MISSION_COMPLETED
  ) {

    return;
  }
}
