// ============================================================
// ADD ESP-NOW PEER
// ============================================================

void addPeer(
  uint8_t *macAddress
) {

  if (
    esp_now_is_peer_exist(
      macAddress
    )
  ) {

    return;
  }

  esp_now_peer_info_t peerInfo = {};

  memcpy(
    peerInfo.peer_addr,
    macAddress,
    6
  );

  peerInfo.channel = 1;

  peerInfo.encrypt = false;

  esp_err_t result =
    esp_now_add_peer(
      &peerInfo
    );

  if (
    result == ESP_OK
  ) {

    Serial.println(
      "Peer added"
    );
  }

  else {

    Serial.print(
      "Peer add failed: "
    );

    Serial.println(
      result
    );
  }
}

// ============================================================
// SEND MESSAGE
// ============================================================

void sendMessage(
  uint8_t *destination,
  const char *message
) {

  esp_err_t result =
    esp_now_send(
      destination,
      (uint8_t *)message,
      strlen(message) + 1
    );

  Serial.print(
    "SEND: "
  );

  Serial.print(
    message
  );

  Serial.print(
    " -> "
  );

  if (
    result == ESP_OK
  ) {

    Serial.println(
      "OK"
    );
  }

  else {

    Serial.println(
      "FAILED"
    );
  }
}

