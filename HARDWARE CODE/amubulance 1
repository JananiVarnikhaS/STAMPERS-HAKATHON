// ============================================================
// START EMERGENCY
// ============================================================

void startEmergency(
  String source
) {

  if (
    missionState != MISSION_IDLE
  ) {

    Serial.println(
      "Mission already active"
    );

    return;
  }

  Serial.println();
  Serial.println(
    "================================"
  );
  Serial.println(
    "       EMERGENCY RECEIVED"
  );
  Serial.println(
    "================================"
  );

  Serial.print(
    "SOURCE: "
  );

  Serial.println(
    source
  );

  Serial.println(
    "PATIENT LOCATION: HOUSE 1"
  );

  Serial.println(
    "A1 SELECTED"
  );

  Serial.println(
    "SHORTEST ROUTE: 5 KM"
  );

  Serial.println(
    "HOUSE -> J1 -> J2"
  );

  Serial.println(
    "DESTINATION: HOSPITAL 1"
  );

  // ==========================================================
  // PREPARE J1
  // ==========================================================

  sendMessage(
    J1_MAC,
    "PREPARE_J1_15"
  );

  j1Prepared =
    true;

  j1Time =
    J1_PREP_TIME;

  j1PreparationTimer =
    millis();

  j1DisplayState =
    DISPLAY_PREPARING;

  // ==========================================================
  // PREPARE J2
  // ==========================================================

  sendMessage(
    J2_MAC,
    "PREPARE_J2_25"
  );

  j2Prepared =
    true;

  j2Time =
    J2_PREP_TIME;

  j2PreparationTimer =
    millis();

  j2DisplayState =
    DISPLAY_PREPARING;

  // ==========================================================
  // J3 REMAINS NORMAL
  // ==========================================================

  j3DisplayState =
    DISPLAY_NORMAL_GREEN;

  // ==========================================================
  // DISPLAY
  // ==========================================================

  displayLCD1(
    "JUNCTION 1",
    "PREP: 15 SEC"
  );

  displayLCD2(
    "JUNCTION 2",
    "PREP: 25 SEC"
  );

  displayLCD3(
    "JUNCTION 3",
    "NORMAL 60 SEC"
  );

  // ==========================================================
  // START J1 MISSION
  // ==========================================================

  missionState =
    MISSION_J1_ACTIVE;
}

// ============================================================
// J1 PREPARATION
// ============================================================

void updateJ1Preparation() {

  if (
    !j1Prepared
  ) {

    return;
  }

  if (
    j1DisplayState !=
    DISPLAY_PREPARING
  ) {

    return;
  }

  if (
    millis() -
    j1PreparationTimer >=
    1000
  ) {

    j1PreparationTimer =
      millis();

    j1Time--;

    if (
      j1Time <= 0
    ) {

      j1Time = 0;

      j1DisplayState =
        DISPLAY_WAITING;

      displayLCD1(
        "JUNCTION 1",
        "WAIT AMBULANCE"
      );

      Serial.println(
        "J1 READY"
      );
    }

    else {

      displayLCD1(
        "JUNCTION 1",
        "PREP: " +
        String(j1Time)
      );
    }
  }
}

