// ============================================================
// SELECT LCD
// ============================================================

void selectLCD(
  uint8_t lcdNumber
) {

  Wire.end();

  delay(2);

  if (lcdNumber == 1) {

    Wire.begin(
      LCD1_SDA,
      LCD1_SCL
    );
  }

  else if (lcdNumber == 2) {

    Wire.begin(
      LCD2_SDA,
      LCD2_SCL
    );
  }

  else {

    Wire.begin(
      LCD3_SDA,
      LCD3_SCL
    );
  }

  Wire.setClock(100000);

  delay(2);
}

// ============================================================
// LCD INITIALIZATION
// ============================================================

void initializeLCDs() {

  selectLCD(1);

  lcd1.init();
  lcd1.backlight();
  lcd1.clear();

  selectLCD(2);

  lcd2.init();
  lcd2.backlight();
  lcd2.clear();

  selectLCD(3);

  lcd3.init();
  lcd3.backlight();
  lcd3.clear();
}

