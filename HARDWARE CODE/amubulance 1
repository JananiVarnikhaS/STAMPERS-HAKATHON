// ============================================================
// NORMAL J1
// ============================================================

void runNormalJ1() {

  if (
    missionState != MISSION_IDLE
  ) {

    return;
  }

  if (
    millis() -
    j1NormalTimer >=
    1000
  ) {

    j1NormalTimer =
      millis();

    j1Time--;

    if (
      j1Time < 0
    ) {

      if (
        j1NormalGreen
      ) {

        j1NormalGreen =
          false;

        j1Time =
          NORMAL_YELLOW_TIME;
      }

      else {

        j1NormalGreen =
          true;

        j1Time =
          NORMAL_GREEN_TIME;
      }
    }
  }
}

