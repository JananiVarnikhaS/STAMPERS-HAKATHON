import 'dart:async';
import 'package:flutter/material.dart';

void main() {
  runApp(const LifeLaneHospitalApp());
}

class LifeLaneHospitalApp extends StatelessWidget {
  const LifeLaneHospitalApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'LifeLane AI - Hospital',
      theme: ThemeData(
        useMaterial3: true,
        colorSchemeSeed: Colors.red,
      ),
      home: const HospitalDashboard(),
    );
  }
}

class HospitalDashboard extends StatefulWidget {
  const HospitalDashboard({super.key});

  @override
  State<HospitalDashboard> createState() =>
      _HospitalDashboardState();
}

class _HospitalDashboardState
    extends State<HospitalDashboard> {

  bool ambulanceIncoming = true;
  bool traumaTeamReady = false;
  bool emergencyRoomReady = false;
  bool doctorNotified = false;

  String ambulanceId = 'AMB-102';
  String patientName = 'Emergency Patient';
  String emergencyType = 'Road Accident';

  String ambulanceStatus = 'En Route';
  String trafficStatus = 'Moderate';
  String routeStatus = 'AI Optimized Route';

  int eta = 12;

  double ambulanceProgress = 0.45;

  Timer? timer;

  @override
  void initState() {
    super.initState();
    startEtaTimer();
  }

  @override
  void dispose() {
    timer?.cancel();
    super.dispose();
  }

  // ------------------------------------------------------------
  // ETA TIMER
  // ------------------------------------------------------------

  void startEtaTimer() {
    timer = Timer.periodic(
      const Duration(seconds: 10),
      (timer) {

        if (!ambulanceIncoming) {
          timer.cancel();
          return;
        }

        if (eta > 1) {
          setState(() {
            eta--;
            ambulanceProgress += 0.03;

            if (ambulanceProgress > 1) {
              ambulanceProgress = 1;
            }
          });
        } else {
          setState(() {
            eta = 0;
            ambulanceStatus = 'Arrived';
            ambulanceIncoming = false;
            ambulanceProgress = 1;
          });

          timer.cancel();

          showMessage(
            'Ambulance has arrived at the hospital.',
          );
        }
      },
    );
  }

  // ------------------------------------------------------------
  // SIMULATE NEW AMBULANCE
  // ------------------------------------------------------------

  void simulateNewAmbulance() {

    setState(() {
      ambulanceIncoming = true;
      ambulanceId = 'AMB-205';
      patientName = 'Emergency Patient';
      emergencyType = 'Critical Injury';
      ambulanceStatus = 'En Route';
      trafficStatus = 'High';
      routeStatus = 'AI Optimized Route';
      eta = 15;
      ambulanceProgress = 0.25;
    });

    timer?.cancel();
    startEtaTimer();

    showMessage(
      'New ambulance emergency received.',
    );
  }

  // ------------------------------------------------------------
  // PREPARE HOSPITAL
  // ------------------------------------------------------------

  void prepareHospital() {

    setState(() {
      traumaTeamReady = true;
      emergencyRoomReady = true;
      doctorNotified = true;
    });

    showMessage(
      'Emergency team has been notified.',
    );
  }

  // ------------------------------------------------------------
  // MARK ARRIVED
  // ------------------------------------------------------------

  void markArrived() {

    timer?.cancel();

    setState(() {
      ambulanceStatus = 'Arrived';
      ambulanceIncoming = false;
      eta = 0;
      ambulanceProgress = 1;
    });

    showMessage(
      'Ambulance marked as arrived.',
    );
  }

  // ------------------------------------------------------------
  // NOTIFY DOCTOR
  // ------------------------------------------------------------

  void notifyDoctor() {

    setState(() {
      doctorNotified = true;
    });

    showMessage(
      'Doctor has been notified.',
    );
  }

  // ------------------------------------------------------------
  // MESSAGE
  // ------------------------------------------------------------

  void showMessage(String message) {

    if (!mounted) return;

    ScaffoldMessenger.of(context)
        .showSnackBar(
      SnackBar(
        content: Text(message),
        duration:
            const Duration(seconds: 2),
      ),
    );
  }

  // ------------------------------------------------------------
  // MAIN UI
  // ------------------------------------------------------------

  @override
  Widget build(BuildContext context) {

    return Scaffold(

      appBar: AppBar(

        title: const Row(
          children: [

            Icon(
              Icons.local_hospital,
              color: Colors.red,
            ),

            SizedBox(width: 8),

            Text(
              'LifeLane AI',
              style: TextStyle(
                fontWeight:
                    FontWeight.bold,
              ),
            ),
          ],
        ),

        actions: [

          IconButton(
            onPressed: () {
              showMessage(
                'Hospital system is online.',
              );
            },
            icon: const Icon(
              Icons.notifications,
            ),
          ),

          IconButton(
            onPressed: () {
              showMessage(
                'Hospital admin settings.',
              );
            },
            icon: const Icon(
              Icons.settings,
            ),
          ),
        ],
      ),

      body: SafeArea(

        child: SingleChildScrollView(

          padding:
              const EdgeInsets.all(16),

          child: Column(

            crossAxisAlignment:
                CrossAxisAlignment.start,

            children: [

              hospitalHeader(),

              const SizedBox(height: 20),

              emergencyAlert(),

              const SizedBox(height: 20),

              ambulanceStatusCard(),

              const SizedBox(height: 20),

              etaAndTraffic(),

              const SizedBox(height: 20),

              liveMap(),

              const SizedBox(height: 20),

              patientInformation(),

              const SizedBox(height: 20),

              preparationStatus(),

              const SizedBox(height: 20),

              actionButtons(),

              const SizedBox(height: 20),

              simulateButton(),
            ],
          ),
        ),
      ),
    );
  }

  // ------------------------------------------------------------
  // HOSPITAL HEADER
  // ------------------------------------------------------------

  Widget hospitalHeader() {

    return Card(

      elevation: 3,

      child: Padding(

        padding:
            const EdgeInsets.all(16),

        child: Row(

          children: [

            const CircleAvatar(

              radius: 32,

              child: Icon(
                Icons.local_hospital,
                size: 38,
              ),
            ),

            const SizedBox(width: 15),

            const Expanded(

              child: Column(

                crossAxisAlignment:
                    CrossAxisAlignment.start,

                children: [

                  Text(
                    'City General Hospital',
                    style: TextStyle(
                      fontSize: 20,
                      fontWeight:
                          FontWeight.bold,
                    ),
                  ),

                  SizedBox(height: 5),

                  Text(
                    'Emergency Department',
                  ),

                  Text(
                    'System Status: Online',
                    style: TextStyle(
                      color: Colors.green,
                      fontWeight:
                          FontWeight.bold,
                    ),
                  ),
                ],
              ),
            ),

            Container(

              padding:
                  const EdgeInsets.symmetric(
                horizontal: 10,
                vertical: 6,
              ),

              decoration:
                  BoxDecoration(
                color: Colors.green,
                borderRadius:
                    BorderRadius.circular(20),
              ),

              child: const Text(
                'ONLINE',
                style: TextStyle(
                  color: Colors.white,
                  fontWeight:
                      FontWeight.bold,
                  fontSize: 12,
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  // ------------------------------------------------------------
  // EMERGENCY ALERT
  // ------------------------------------------------------------

  Widget emergencyAlert() {

    return Card(

      color: Colors.red.shade50,

      child: Padding(

        padding:
            const EdgeInsets.all(16),

        child: Row(

          children: [

            const Icon(
              Icons.warning_amber,
              color: Colors.red,
              size: 40,
            ),

            const SizedBox(width: 15),

            Expanded(

              child: Column(

                crossAxisAlignment:
                    CrossAxisAlignment.start,

                children: [

                  const Text(
                    'INCOMING AMBULANCE',
                    style: TextStyle(
                      color: Colors.red,
                      fontSize: 18,
                      fontWeight:
                          FontWeight.bold,
                    ),
                  ),

                  const SizedBox(height: 5),

                  Text(
                    ambulanceIncoming
                        ? '$ambulanceId is approaching the hospital'
