    return Column(

      crossAxisAlignment:
          CrossAxisAlignment.start,

      children: [

        const Text(
          'Emergency Information',
          style: TextStyle(
            fontSize: 22,
            fontWeight:
                FontWeight.bold,
          ),
        ),

        const SizedBox(height: 10),

        Card(

          child: Column(

            children: [

              informationRow(
                Icons.person,
                'Patient',
                patientName,
              ),

              const Divider(
                height: 1,
              ),

              informationRow(
                Icons.emergency,
                'Emergency Type',
                emergencyType,
              ),

              const Divider(
                height: 1,
              ),

              informationRow(
                Icons.local_shipping,
