      subtitle: Text(
        value,
        style:
            const TextStyle(
          fontSize: 16,
          fontWeight:
              FontWeight.bold,
        ),
      ),
    );
  }

  // ------------------------------------------------------------
  // PREPARATION STATUS
  // ------------------------------------------------------------

  Widget preparationStatus() {

    return Column(

      crossAxisAlignment:
          CrossAxisAlignment.start,

      children: [

        const Text(
          'Hospital Preparation',
          style: TextStyle(
            fontSize: 22,
            fontWeight:
                FontWeight.bold,
          ),
        ),

        const SizedBox(height: 10),

        preparationTile(
          'Trauma Team',
          traumaTeamReady,
          Icons.groups,
        ),

        preparationTile(
          'Emergency Room',
          emergencyRoomReady,
          Icons.meeting_room,
        ),

        preparationTile(
          'Doctor',
          doctorNotified,
          Icons.medical_services,
        ),
      ],
    );
  }

  Widget preparationTile(
    String title,
    bool ready,
    IconData icon,
  ) {

    return Card(

      child: ListTile(

        leading: Icon(
          icon,
          color: ready
              ? Colors.green
              : Colors.grey,
          size: 30,
        ),

        title: Text(
          title,
          style:
              const TextStyle(
            fontWeight:
                FontWeight.bold,
          ),
        ),

        subtitle: Text(
          ready
              ? 'Ready / Notified'
              : 'Waiting',
        ),

        trailing: Icon(
          ready
              ? Icons.check_circle
              : Icons.pending,
          color: ready
              ? Colors.green
              : Colors.orange,
        ),
      ),
    );
  }

  // ------------------------------------------------------------
  // ACTION BUTTONS
  // ------------------------------------------------------------

  Widget actionButtons() {

    return Column(

      children: [

        SizedBox(

          width:
              double.infinity,

          child:
              ElevatedButton.icon(

            onPressed:
                prepareHospital,

            icon:
                const Icon(
              Icons.medical_services,
            ),

            label:
                const Text(
              'PREPARE EMERGENCY TEAM',
