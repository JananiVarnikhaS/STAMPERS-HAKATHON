    return Column(
      children: [

        SizedBox(
          width: double.infinity,
          child: OutlinedButton.icon(
            onPressed:
                emergencyActive
                    ? simulateIncident
                    : null,
            icon: const Icon(
              Icons.warning,
            ),
            label: const Text(
              'SIMULATE TRAFFIC INCIDENT',
            ),
          ),
        ),

        const SizedBox(height: 10),

        SizedBox(
          width: double.infinity,
          child: OutlinedButton.icon(
            onPressed:
                incidentDetected
                    ? recalculateRoute
                    : null,
            icon: const Icon(
              Icons.route,
            ),
            label: const Text(
              'AI RECALCULATE ROUTE',
            ),
          ),
        ),

        const SizedBox(height: 10),

        if (emergencyActive)
          SizedBox(
            width: double.infinity,
            child: ElevatedButton.icon(
              onPressed:
                  completeEmergency,
              icon: const Icon(
                Icons.check_circle,
              ),
              label: const Text(
                'ARRIVED AT HOSPITAL',
              ),
              style:
                  ElevatedButton.styleFrom(
                backgroundColor:
                    Colors.green,
                foregroundColor:
                    Colors.white,
              ),
            ),
          ),
      ],
    );
  }

  // ------------------------------------------------------------
  // GPS SECTION
  // ------------------------------------------------------------

  Widget gpsSection() {
    return Card(
      child: ListTile(
        leading: Icon(
          locationLoading
              ? Icons.gps_not_fixed
              : Icons.gps_fixed,
          color: Colors.red,
        ),

        title: const Text(
          'GPS Location',
          style: TextStyle(
            fontWeight:
                FontWeight.bold,
          ),
        ),

        subtitle: Text(
          latitude == null
              ? 'Location not loaded'
              : 'Lat: ${latitude!.toStringAsFixed(5)}\n'
                'Lng: ${longitude!.toStringAsFixed(5)}',
