  // ------------------------------------------------------------
  // STATUS SECTION
  // ------------------------------------------------------------

  Widget statusSection() {
    return Column(
      crossAxisAlignment:
          CrossAxisAlignment.start,
      children: [

        const Text(
          'Emergency Status',
          style: TextStyle(
            fontSize: 22,
            fontWeight:
                FontWeight.bold,
          ),
        ),

        const SizedBox(height: 10),

        Row(
          children: [

            Expanded(
              child: statusCard(
                'ETA',
                emergencyActive
                    ? '$eta min'
                    : '--',
                Icons.timer,
                Colors.blue,
              ),
            ),

            const SizedBox(width: 10),

            Expanded(
              child: statusCard(
                'Traffic',
                trafficStatus,
                Icons.traffic,
                Colors.orange,
              ),
            ),
          ],
        ),

        const SizedBox(height: 10),

        Card(
          child: ListTile(
