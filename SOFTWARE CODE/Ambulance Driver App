import 'dart:async';
import 'package:flutter/material.dart';
import 'package:geolocator/geolocator.dart';

void main() {
  runApp(const LifeLaneAI());
}

class LifeLaneAI extends StatelessWidget {
  const LifeLaneAI({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'LifeLane AI',
      theme: ThemeData(
        useMaterial3: true,
        colorSchemeSeed: Colors.red,
      ),
      home: const AmbulanceDriverApp(),
    );
  }
}

class AmbulanceDriverApp extends StatefulWidget {
  const AmbulanceDriverApp({super.key});

  @override
  State<AmbulanceDriverApp> createState() =>
      _AmbulanceDriverAppState();
}

class _AmbulanceDriverAppState
    extends State<AmbulanceDriverApp> {

  bool emergencyActive = false;
  bool greenCorridor = false;
  bool incidentDetected = false;
  bool locationLoading = false;

  String selectedHospital = 'City General Hospital';
  String selectedRoute = 'Primary Route';
  String trafficStatus = 'Moderate';

  int eta = 12;
  double? latitude;
  double? longitude;

  Timer? etaTimer;

  final List<String> hospitals = [
    'City General Hospital',
    'Apollo Hospital',
    'Government Medical Hospital',
    'Emergency Trauma Center',
  ];

  @override
  void dispose() {
    etaTimer?.cancel();
    super.dispose();
  }

  // ------------------------------------------------------------
  // GET GPS LOCATION
  // ------------------------------------------------------------

  Future<void> getCurrentLocation() async {
    setState(() {
      locationLoading = true;
    });

    try {
      bool serviceEnabled =
          await Geolocator.isLocationServiceEnabled();

      if (!serviceEnabled) {
        showMessage(
          'Please enable GPS/location services.',
        );

        setState(() {
          locationLoading = false;
        });

        return;
      }

      LocationPermission permission =
          await Geolocator.checkPermission();

      if (permission == LocationPermission.denied) {
        permission =
            await Geolocator.requestPermission();
      }

      if (permission == LocationPermission.denied ||
          permission ==
              LocationPermission.deniedForever) {
        showMessage(
          'Location permission is required.',
        );

        setState(() {
          locationLoading = false;
        });

        return;
      }

      Position position =
          await Geolocator.getCurrentPosition(
        locationSettings:
            const LocationSettings(
          accuracy: LocationAccuracy.high,
        ),
      );

      setState(() {
        latitude = position.latitude;
        longitude = position.longitude;
        locationLoading = false;
      });

      showMessage(
        'GPS location updated successfully.',
      );
    } catch (e) {
      setState(() {
        locationLoading = false;
      });

      showMessage(
        'Unable to get location.',
      );
    }
  }

  // ------------------------------------------------------------
  // START EMERGENCY
  // ------------------------------------------------------------

  Future<void> startEmergency() async {
    await getCurrentLocation();

    setState(() {
      emergencyActive = true;
      greenCorridor = true;
      incidentDetected = false;
      trafficStatus = 'Moderate';
      selectedRoute = 'AI Recommended Route';
      eta = 12;
    });

    startEtaTimer();

    showEmergencyDialog();
  }

  // ------------------------------------------------------------
  // ETA TIMER
  // ------------------------------------------------------------

  void startEtaTimer() {
    etaTimer?.cancel();

    etaTimer = Timer.periodic(
      const Duration(seconds: 10),
      (timer) {
        if (!emergencyActive) {
          timer.cancel();
          return;
        }

        if (eta > 1) {
          setState(() {
            eta--;
          });
        }
      },
    );
  }

  // ------------------------------------------------------------
  // SIMULATE TRAFFIC INCIDENT
  // ------------------------------------------------------------

  void simulateIncident() {
    if (!emergencyActive) {
      showMessage(
        'Start an emergency trip first.',
      );
      return;
    }

    setState(() {
      incidentDetected = true;
      greenCorridor = false;
      trafficStatus = 'High';
    });

    showMessage(
      'Traffic incident detected at Junction 2.',
    );
  }

  // ------------------------------------------------------------
  // AI REROUTING
  // ------------------------------------------------------------

  void recalculateRoute() {
    if (!incidentDetected) {
      showMessage(
        'No incident detected. Current route is optimal.',
      );
      return;
    }

    setState(() {
      selectedRoute = 'Alternative AI Route';
      trafficStatus = 'Low';
      greenCorridor = true;
      incidentDetected = false;
      eta = 14;
    });

    showMessage(
      'AI selected an alternative route.',
    );

    startEtaTimer();
  }

  // ------------------------------------------------------------
  // END EMERGENCY
  // ------------------------------------------------------------

  void completeEmergency() {
    etaTimer?.cancel();

    setState(() {
      emergencyActive = false;
      greenCorridor = false;
      incidentDetected = false;
      selectedRoute = 'No active route';
      trafficStatus = 'Normal';
      eta = 0;
    });

    showMessage(
      'Ambulance reached the hospital.',
    );
  }

  // ------------------------------------------------------------
  // EMERGENCY DIALOG
  // ------------------------------------------------------------

  void showEmergencyDialog() {
    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: const Row(
            children: [
              Icon(
                Icons.emergency,
                color: Colors.red,
              ),
              SizedBox(width: 10),
              Text('Emergency Activated'),
            ],
          ),
          content: Text(
            'Destination: $selectedHospital\n\n'
            'AI is calculating the fastest route.\n\n'
            'Green corridor request has been sent.',
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(context);
              },
              child: const Text('OK'),
            ),
          ],
        );
      },
    );
  }

  // ------------------------------------------------------------
  // MESSAGE
  // ------------------------------------------------------------

  void showMessage(String message) {
    if (!mounted) return;

    ScaffoldMessenger.of(context)
        .showSnackBar(
      SnackBar(
        content: Text(message),
        duration:
            const Duration(seconds: 2),
      ),
    );
  }

  // ------------------------------------------------------------
  // UI
  // ------------------------------------------------------------

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Row(
          children: [
            Icon(
              Icons.local_hospital,
              color: Colors.red,
            ),
            SizedBox(width: 8),
            Text(
              'LifeLane AI',
              style: TextStyle(
                fontWeight: FontWeight.bold,
              ),
            ),
          ],
        ),
        actions: [
          IconButton(
            onPressed: getCurrentLocation,
            icon: const Icon(
              Icons.my_location,
            ),
            tooltip: 'Get GPS',
          ),
        ],
      ),

      body: SafeArea(
        child: SingleChildScrollView(
          padding: const EdgeInsets.all(16),
          child: Column(
            crossAxisAlignment:
                CrossAxisAlignment.start,
            children: [

              // DRIVER CARD
              driverCard(),

              const SizedBox(height: 15),

              // EMERGENCY BUTTON
              emergencyButton(),

              const SizedBox(height: 20),

              // MAP
              mapSection(),

              const SizedBox(height: 20),

              // STATUS
              statusSection(),

              const SizedBox(height: 20),

              // HOSPITAL
              hospitalSection(),

              const SizedBox(height: 20),

              // ACTION BUTTONS
              actionButtons(),

              const SizedBox(height: 20),

              // GPS
              gpsSection(),
            ],
          ),
        ),
      ),
    );
  }

