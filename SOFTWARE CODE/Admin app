  @override
  State<TrafficAdminDashboard> createState() =>
      _TrafficAdminDashboardState();
}

class _TrafficAdminDashboardState
    extends State<TrafficAdminDashboard> {

  // ------------------------------------------------------------
  // SYSTEM VARIABLES
  // ------------------------------------------------------------

  bool systemOnline = true;
  bool greenCorridorActive = true;
  bool incidentDetected = false;

  String selectedAmbulance = 'AMB-102';

  String routeRecommendation =
      'Primary Route';

  String trafficLevel = 'Moderate';

  int activeEmergencies = 2;
  int activeAmbulances = 3;
  int controlledJunctions = 8;

  Timer? timer;

  // Junction status
  List<Map<String, dynamic>> junctions = [
    {
      'name': 'Junction 1',
      'traffic': 'Low',
      'signal': 'Normal',
      'ambulance': false,
    },
    {
      'name': 'Junction 2',
      'traffic': 'High',
      'signal': 'Priority',
      'ambulance': true,
    },
    {
      'name': 'Junction 3',
      'traffic': 'Medium',
      'signal': 'Normal',
      'ambulance': false,
    },
    {
      'name': 'Junction 4',
      'traffic': 'Low',
      'signal': 'Normal',
      'ambulance': false,
    },
  ];

  // Ambulance data
  List<Map<String, dynamic>> ambulances = [
    {
      'id': 'AMB-102',
      'status': 'Emergency',
      'eta': 12,
      'traffic': 'Moderate',
      'route': 'Primary Route',
    },
    {
      'id': 'AMB-205',
      'status': 'Emergency',
      'eta': 8,
      'traffic': 'Low',
      'route': 'Alternative Route',
    },
    {
      'id': 'AMB-301',
      'status': 'Available',
      'eta': 0,
      'traffic': 'Normal',
      'route': 'No Active Route',
    },
  ];

  @override
  void initState() {
    super.initState();

    timer = Timer.periodic(
      const Duration(seconds: 10),
      (timer) {
        updateDashboard();
      },
    );
  }

  @override
  void dispose() {
    timer?.cancel();
    super.dispose();
  }

  // ------------------------------------------------------------
  // UPDATE DASHBOARD
  // ------------------------------------------------------------

  void updateDashboard() {
    if (!mounted) return;

    setState(() {
      for (var ambulance in ambulances) {
        if (ambulance['status'] == 'Emergency' &&
            ambulance['eta'] > 1) {
          ambulance['eta']--;
        }
      }
    });
  }

  // ------------------------------------------------------------
  // ACTIVATE GREEN CORRIDOR
  // ------------------------------------------------------------

  void activateGreenCorridor() {
    setState(() {
      greenCorridorActive = true;

      for (var junction in junctions) {
        if (junction['ambulance'] == true) {
          junction['signal'] = 'Priority';
        }
      }
    });

    showMessage(
      'Green corridor activated for emergency vehicles.',
    );
  }

  // ------------------------------------------------------------
  // DISABLE GREEN CORRIDOR
  // ------------------------------------------------------------

  void disableGreenCorridor() {
    setState(() {
      greenCorridorActive = false;

      for (var junction in junctions) {
        if (junction['signal'] == 'Priority') {
          junction['signal'] = 'Normal';
        }
      }
    });

    showMessage(
      'Green corridor deactivated.',
    );
  }

  // ------------------------------------------------------------
  // DETECT INCIDENT
  // ------------------------------------------------------------

  void detectIncident() {
    setState(() {
      incidentDetected = true;
      trafficLevel = 'High';

      junctions[1]['traffic'] = 'Critical';
      junctions[1]['signal'] = 'Incident';

      routeRecommendation =
          'Alternative Route';
    });

    showMessage(
      'Traffic incident detected at Junction 2.',
    );
  }

  // ------------------------------------------------------------
  // CLEAR INCIDENT
  // ------------------------------------------------------------

  void clearIncident() {
    setState(() {
      incidentDetected = false;
      trafficLevel = 'Moderate';

      junctions[1]['traffic'] = 'High';
      junctions[1]['signal'] =
          greenCorridorActive
              ? 'Priority'
              : 'Normal';

      routeRecommendation =
          'Primary Route';
    });

    showMessage(
      'Traffic incident cleared.',
    );
  }

  // ------------------------------------------------------------
  // AI ROUTE ANALYSIS
  // ------------------------------------------------------------

  void runAIAnalysis() {
    setState(() {
      if (incidentDetected) {
        routeRecommendation =
            'Alternative Route';
      } else if (trafficLevel == 'High') {
        routeRecommendation =
            'Alternative Route';
      } else {
        routeRecommendation =
            'Primary Route';
      }
    });

    showMessage(
      'AI route analysis completed.',
    );
  }

  // ------------------------------------------------------------
  // PRIORITIZE AMBULANCE
  // ------------------------------------------------------------

  void prioritizeAmbulance(String ambulanceId) {
    setState(() {
      selectedAmbulance = ambulanceId;

      for (var ambulance in ambulances) {
        if (ambulance['id'] == ambulanceId) {
          ambulance['status'] = 'Emergency';
        }
      }

      for (var junction in junctions) {
        if (junction['name'] == 'Junction 2') {
          junction['ambulance'] = true;
          junction['signal'] = 'Priority';
        }
      }

      greenCorridorActive = true;
    });

    showMessage(
      '$ambulanceId has been prioritized.',
    );
  }

  // ------------------------------------------------------------
  // SIMULATE EMERGENCY
  // ------------------------------------------------------------

  void simulateEmergency() {
    setState(() {
      activeEmergencies++;

      ambulances.add({
        'id': 'AMB-${400 + activeEmergencies}',
        'status': 'Emergency',
        'eta': 15,
        'traffic': 'Moderate',
        'route': 'AI Route',
      });

      activeAmbulances++;

      junctions[1]['ambulance'] = true;
      junctions[1]['signal'] = 'Priority';

      greenCorridorActive = true;
    });

    showMessage(
      'New ambulance emergency request received.',
    );
  }

  // ------------------------------------------------------------
  // MESSAGE
  // ------------------------------------------------------------

  void showMessage(String message) {
    if (!mounted) return;

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(message),
        duration:
            const Duration(seconds: 2),
      ),
    );
  }

