  Color getTrafficColor(String traffic) {
    switch (traffic) {
      case 'Low':
        return Colors.green;

      case 'Medium':
        return Colors.orange;

      case 'High':
        return Colors.deepOrange;

      case 'Critical':
        return Colors.red;

      default:
        return Colors.grey;
    }
  }

  Color getSignalColor(String signal) {
    switch (signal) {
      case 'Priority':
        return Colors.green;

      case 'Incident':
        return Colors.red;

      case 'Normal':
        return Colors.blue;

      default:
        return Colors.grey;
    }
  }

